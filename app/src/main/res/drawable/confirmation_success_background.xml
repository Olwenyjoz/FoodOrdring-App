<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Light green background -->
    <solid android:color="#E8F8EE"/>

    <!-- Slight green border -->
    <stroke
        android:width="1dp"
        android:color="#B7E4C7"/>

    <!-- Rounded corners -->
    <corners android:radius="12dp"/>

    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp"/>

</shape>