<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/foodie_background"
    android:padding="16dp">

    <!-- Hero Section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:padding="8dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/hero_background">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/background"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_message"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hero_subtitle"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

    </FrameLayout>

    <!-- Search -->
    <EditText
        android:id="@+id/etSearchFood"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/search_background"
        android:hint="@string/search_food"
        android:inputType="text"
        android:importantForAutofill="no"
        android:drawableStart="@drawable/search_icon"
        android:drawablePadding="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/foodie_text"
        android:textColorHint="@color/foodie_secondary_text"
        android:textSize="14sp"/>

    <!-- Categories Heading -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/categories"
            android:textColor="@color/foodie_text"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSeeAll"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/see_all"
            android:textColor="@color/foodie_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Categories -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Burger -->
            <TextView
                android:id="@+id/categoryBurger"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/category_button"
                android:gravity="center"
                android:text="@string/category_burger_display"
                android:textColor="@color/foodie_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="48dp"
                android:minHeight="48dp"/>

            <!-- Pizza -->
            <TextView
                android:id="@+id/categoryPizza"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/category_button"
                android:gravity="center"
                android:text="@string/category_pizza_display"
                android:textColor="@color/foodie_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="48dp"
                android:minHeight="48dp"/>

            <!-- Chicken -->
            <TextView
                android:id="@+id/categoryChicken"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/category_button"
                android:gravity="center"
                android:text="@string/category_chicken_display"
                android:textColor="@color/foodie_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="48dp"
                android:minHeight="48dp"/>

            <!-- Tacos -->
            <TextView
                android:id="@+id/categoryTacos"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/category_button"
                android:gravity="center"
                android:text="@string/category_tacos_display"
                android:textColor="@color/foodie_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="48dp"
                android:minHeight="48dp"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Popular Foods Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/popular_foods"
        android:textColor="@color/foodie_text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Popular Foods -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFood"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"/>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        android:background="@drawable/bottom_nav_background">

        <!-- Home -->
        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            app:drawableTopCompat="@drawable/home_icon"
            android:drawablePadding="2dp"
            android:text="@string/navigation_home"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/foodie_primary"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"/>

        <!-- Cart -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navCart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                app:drawableTopCompat="@drawable/orders_icon"
                android:drawablePadding="2dp"
                android:text="@string/navigation_cart"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/foodie_secondary_text"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"/>

            <!-- Cart Badge -->
            <TextView
                android:id="@+id/tvCartBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/cart_badge"
                android:gravity="center"
                android:text="@string/cart_badge_default"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Orders -->
        <TextView
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            app:drawableTopCompat="@drawable/orders_icon"
            android:drawablePadding="2dp"
            android:text="@string/navigation_orders"
            android:textSize="11sp"
            android:textColor="@color/foodie_secondary_text"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"/>

        <!-- Profile -->
        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            app:drawableTopCompat="@drawable/profile_icon"
            android:drawablePadding="2dp"
            android:text="@string/navigation_profile"
            android:textSize="11sp"
            android:textColor="@color/foodie_secondary_text"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"/>

    </LinearLayout>

</LinearLayout>