<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/foodie_background">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/foodie_primary">

        <Button
            android:id="@+id/tvBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:background="@android:color/transparent"
            android:text="@string/back"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:gravity="center"
            android:contentDescription="@string/navigate_back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/order_now_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>

    </LinearLayout>

    <!-- ORDER CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- FOOD IMAGE -->
            <ImageView
                android:id="@+id/ivOrderFood"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:scaleType="centerCrop"
                android:src="@drawable/background"
                android:contentDescription="@string/food_name"/>

            <!-- FOOD NAME -->
            <TextView
                android:id="@+id/tvOrderFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/chicken_pizza"
                android:textColor="@color/foodie_text"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <!-- FOOD PRICE -->
            <TextView
                android:id="@+id/tvOrderFoodPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/chicken_pizza_price"
                android:textColor="@color/foodie_primary"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <!-- QUANTITY LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/quantity"
                android:textColor="@color/foodie_text"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <!-- QUANTITY CONTROLS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnDecrease"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    android:text="@string/quantity_decrease"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:contentDescription="@string/quantity_decrease"/>

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/quantity_default"
                    android:textColor="@color/foodie_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnIncrease"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    android:text="@string/quantity_increase"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:contentDescription="@string/quantity_increase"/>

            </LinearLayout>

            <!-- TOTAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total"
                    android:textColor="@color/foodie_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvOrderTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_default"
                    android:textColor="@color/foodie_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- ADD TO CART -->
            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="220dp"
                android:minHeight="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="@string/add_to_cart"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- PLACE ORDER NOW -->
            <Button
                android:id="@+id/btnPlaceOrderNow"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="220dp"
                android:minHeight="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/place_order_now"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>