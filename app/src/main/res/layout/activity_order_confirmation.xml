<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/confirmationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/foodie_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/confirmationHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/foodie_primary">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/tvConfirmationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/order_confirmation"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"/>

    </LinearLayout>

    <!-- Confirmation Content -->
    <ScrollView
        android:id="@+id/confirmationScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/confirmationContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- Success Message -->
            <LinearLayout
                android:id="@+id/confirmationBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/confirmation_success_background">

                <TextView
                    android:id="@+id/tvConfirmationCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirmation_check"
                    android:textColor="#138A3D"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvConfirmationMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/order_confirmation_message"
                    android:textColor="#087F36"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Order Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/order_details"
                android:textColor="@color/foodie_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- Customer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/customer_label"
                    android:textColor="@color/foodie_secondary_text"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvConfirmationCustomer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/foodie_text"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_label"
                    android:textColor="@color/foodie_secondary_text"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvConfirmationPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/foodie_text"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/address_label"
                    android:textColor="@color/foodie_secondary_text"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvConfirmationAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/foodie_text"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- Items Ordered -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/items_ordered"
                android:textColor="@color/foodie_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- Order Summary Card -->
            <LinearLayout
                android:id="@+id/confirmationOrderSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/food_card">

                <!-- Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/order_summary_item"
                        android:textColor="@color/foodie_secondary_text"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/order_summary_quantity"
                        android:textColor="@color/foodie_secondary_text"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/order_summary_amount"
                        android:textColor="@color/foodie_secondary_text"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2DDEE"
                    android:importantForAccessibility="no"/>

                <!-- Dynamic Order Items -->
                <LinearLayout
                    android:id="@+id/confirmationOrderSummaryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

            <!-- Totals Container -->
            <LinearLayout
                android:id="@+id/confirmationTotalsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@android:color/white">

                <!-- Total Items -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/total_items"
                        android:textColor="@color/foodie_text"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvConfirmationTotalItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quantity_default"
                        android:textColor="@color/foodie_text"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Total Paid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/total_paid_background">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/total_paid"
                        android:textColor="@color/foodie_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvConfirmationTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cart_total_default"
                        android:textColor="@color/foodie_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Back Home -->
            <Button
                android:id="@+id/btnBackHome"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/back_to_home"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="ButtonStyle"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>